# Visual Studio 2015 user specific files
CrossviewHunter/.vs/
CrossviewHunter/.vsconfig

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

*.pdb

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
CrossviewHunter/SourceArt/**/*.png
CrossviewHunter/SourceArt/**/*.tga

# Binary Files
CrossviewHunter/Binaries/*
CrossviewHunter/Plugins/*/Binaries/*

# Builds
CrossviewHunter/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!CrossviewHunter/Build/*/
CrossviewHunter/Build/*/**
!CrossviewHunter/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!CrossviewHunter/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
CrossviewHunter/Saved/*

# Compiled source files for the engine to use
CrossviewHunter/Intermediate/*
CrossviewHunter/Plugins/*/Intermediate/*
CrossviewHunter/Plugins/GameFeatures/*/Intermediate/*

# Cache files for the editor to use
CrossviewHunter/DerivedDataCache/*

# Spotlight index files
.DS_Store

# Visual Studio Code files
.vscode
*.code-workspace

# Rider user specific files
CrossviewHunter/.idea/
CrossviewHunter/Plugins/Developer/RiderLink
CrossviewHunter/*.DotSettings.user

# Division files
CrossviewHunter/.dvignore
CrossviewHunter/.diversion/

# Content files
CrossviewHunter/Content/*
CrossviewHunter/Plugins/*/Content/*
CrossviewHunter/Plugins/GameFeatures/*/Content/*

#Claude
.claude/
CrossviewHunter/.claude/
CrossviewHunter/CLAUDE.md
.serena/
CrossviewHunter/nul
